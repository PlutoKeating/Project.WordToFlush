# ============================================================
# WordToFlush Backend 环境变量配置
# 复制此文件为 .env 并修改相应值
#   cp .env.example .env
# ============================================================

# Docker Compose 项目名（用于隔离不同项目堆栈）
COMPOSE_PROJECT_NAME=word-to-flush-backend

# 宿主机映射端口 — 容器内 API 服务始终监听 8000
# 修改此端口可改变外部访问端口，避免与宿主机其他服务冲突
HOST_BIND_PORT=8000

# ============================================================
# Admin 控制面板配置
# ============================================================
# 控制面板宿主机映射端口 — 容器内固定监听 8001
ADMIN_HOST_BIND_PORT=8001
# 控制面板登录凭证（必填，禁止在代码中硬编码）
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Flask 会话加密密钥（留空自动生成随机密钥）
FLASK_SECRET_KEY=

# ============================================================
# Ollama 嵌入模型配置
# ============================================================
# Ollama API 地址（docker 容器内请使用 host.docker.internal 访问宿主机）
OLLAMA_HOST=http://host.docker.internal:11434
# 嵌入模型名称
#   bge-large-zh  — 推荐，中文语义精度高，维度 1024
#   all-minilm    — 轻量替代，维度 384，CPU 友好
OLLAMA_MODEL=bge-large-zh
# 猜中关联度阈值（余弦相似度 >= 此值判定为猜中，0.0-1.0）
WIN_AFFINITY_THRESHOLD=0.92

# ============================================================
# Redis 配置
# ============================================================
# Redis 连接地址（docker-compose 内网使用服务名 redis，宿主机开发使用 localhost）
REDIS_URL=redis://redis:6379

# ============================================================
# 平台凭证（可选，仅在使用各直播平台官方 API 时需要）
# ============================================================
DY_APP_ID=
KS_APP_KEY=
BILI_PROJECT_ID=

# ============================================================
# WordToFlush Frontend 环境变量配置
# 复制此文件为 .env 并修改相应值
#   cp .env.example .env
# ============================================================

# Vite 开发服务器监听端口
VITE_DEV_SERVER_PORT=3000

# 后端 API 与 WebSocket 服务地址（含协议与端口）
VITE_BACKEND_URL=http://localhost:8000
